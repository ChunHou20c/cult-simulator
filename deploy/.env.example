# Copy to deploy/.env and replace every value. Never commit deploy/.env.
POSTGRES_PASSWORD=change-me
NAKAMA_SERVER_KEY=change-me-server-key
NAKAMA_SESSION_KEY=change-me-session-key
NAKAMA_REFRESH_KEY=change-me-refresh-key
NAKAMA_HTTP_KEY=change-me-http-key
NAKAMA_CONSOLE_PASSWORD=change-me
# Where the web build publishes packs, e.g. https://play.example.com/packs
# Leave empty to have clients fetch packs over the get_pack RPC.
ASSET_BASE=
# 86400 in production. A short value (e.g. 900) makes Days 15 minutes for testing.
DAY_SECONDS=86400
# From the Cloudflare dashboard (Zero Trust > Tunnels). Route play.<domain> to http://nakama:7350.
CLOUDFLARE_TUNNEL_TOKEN=
# Image tag to pull from ghcr.io (latest = main; or a short sha / version).
IMAGE_TAG=latest
# Web container (profile "web"): where browsers reach Nakama. Empty = same host
# as the page, port 443 over https. e.g. play.example.com / 443 / true
WEB_NAKAMA_HOST=
WEB_NAKAMA_PORT=
WEB_NAKAMA_SSL=
