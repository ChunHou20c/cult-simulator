{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cult-simulator/schema/v1.json",
  "title": "Cult pack manifest, schema 1.x",
  "type": "object",
  "required": ["schema", "id", "version", "difficulty", "goal", "actions"],
  "additionalProperties": false,
  "definitions": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,39}$" },
    "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9_.]{1,79}$" },
    "expr": { "type": "string", "minLength": 1, "maxLength": 400 },
    "value": { "oneOf": [{ "type": "number" }, { "$ref": "#/definitions/expr" }] },
    "effect": {
      "type": "object",
      "required": ["stat"],
      "additionalProperties": false,
      "properties": {
        "stat": { "$ref": "#/definitions/id" },
        "add": { "$ref": "#/definitions/value" },
        "mul": { "$ref": "#/definitions/value" },
        "set": { "$ref": "#/definitions/value" },
        "scale": { "enum": ["yield"] }
      },
      "oneOf": [
        { "required": ["add"] },
        { "required": ["mul"] },
        { "required": ["set"] }
      ]
    },
    "buff": {
      "type": "object",
      "required": ["id", "target", "mul", "durationMin"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "target": { "$ref": "#/definitions/id" },
        "mul": { "type": "number", "exclusiveMinimum": 0, "maximum": 3 },
        "durationMin": { "type": "number", "exclusiveMinimum": 0, "maximum": 240 }
      }
    },
    "action": {
      "type": "object",
      "required": ["id", "effects"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/definitions/id" },
        "energy": { "type": "integer", "minimum": 1, "maximum": 4 },
        "cooldownSec": { "type": "integer", "minimum": 0, "maximum": 3600 },
        "requires": { "$ref": "#/definitions/expr" },
        "effects": { "type": "array", "items": { "$ref": "#/definitions/effect" } },
        "buff": { "$ref": "#/definitions/buff" },
        "phases": { "type": "array", "items": { "$ref": "#/definitions/id" } },
        "slot": {
          "description": "Since 1.1. One of the three action buttons: recruit (person-plus icon), work (coin), devote (heart). A pack uses all three or none.",
          "enum": ["recruit", "work", "devote"]
        },
        "game": {
          "description": "Since 1.1. Mini game from the engine catalog (server/minigame) played for this action. Any game can go in any slot.",
          "enum": ["flick", "timing", "beat"]
        },
        "skin": {
          "description": "Since 1.1. Display only: what the mini game shows, as short emoji or symbols.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "target": { "type": "string", "maxLength": 16 },
            "item": { "type": "string", "maxLength": 16 },
            "zone": { "type": "string", "maxLength": 16 }
          }
        }
      }
    },
    "fall": {
      "type": "object",
      "required": ["when", "reason", "text"],
      "additionalProperties": false,
      "properties": {
        "when": { "$ref": "#/definitions/expr" },
        "reason": { "$ref": "#/definitions/id" },
        "text": { "$ref": "#/definitions/key" },
        "historical": { "type": "boolean" }
      }
    },
    "goal": {
      "type": "object",
      "required": ["progress", "label"],
      "additionalProperties": false,
      "properties": {
        "progress": { "$ref": "#/definitions/expr" },
        "label": { "$ref": "#/definitions/key" }
      }
    }
  },
  "properties": {
    "schema": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "id": { "$ref": "#/definitions/id" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "difficulty": { "enum": ["tutorial", "easy", "medium", "hard"] },
    "names": { "enum": ["real", "fictional"] },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "primary": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "floor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      }
    },
    "stats": {
      "type": "object",
      "propertyNames": { "$ref": "#/definitions/id" },
      "additionalProperties": {
        "type": "object",
        "required": ["widget", "label"],
        "additionalProperties": false,
        "properties": {
          "min": { "type": "number" },
          "max": { "type": "number" },
          "initial": { "type": "number" },
          "widget": { "enum": ["bar", "counter", "currency", "months"] },
          "label": { "$ref": "#/definitions/key" }
        }
      }
    },
    "initial": {
      "type": "object",
      "propertyNames": { "enum": ["followers", "funds", "loyalty", "scrutiny", "paranoia"] },
      "additionalProperties": { "type": "number" }
    },
    "goal": { "$ref": "#/definitions/goal" },
    "guard": { "$ref": "#/definitions/expr" },
    "sharedActions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["recruit", "fundraise", "ritual", "lie_low", "open_doors"] }
    },
    "actions": { "type": "array", "maxItems": 6, "items": { "$ref": "#/definitions/action" } },
    "animations": {
      "description": "3D movement per action id or ritual.<id>. Display only. Values are ids from the web app's animation library (apps/web/src/anim.ts).",
      "type": "object",
      "propertyNames": { "pattern": "^(ritual\\.)?[a-z][a-z0-9_]{1,39}$" },
      "additionalProperties": {
        "enum": ["idle", "walk", "kneel", "sit_talk", "talk", "phone", "fold_arms", "dance", "fix", "interact", "pick_up", "carry", "plant", "harvest", "water", "chop", "open", "consume", "raise_hands", "lantern", "torch", "yes", "no", "crouch", "push"]
      }
    },
    "outfit": {
      "description": "What members wear in the compound (3D and 2D). Display only. Each person gets their own pick of colour, hair and beard, seeded by their player id. Since schema 1.2.",
      "type": "object",
      "required": ["garment", "colors"],
      "additionalProperties": false,
      "properties": {
        "garment": { "enum": ["robe", "overalls", "casual"] },
        "colors": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/definitions/color" } },
        "under": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/definitions/color" } },
        "hair": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "enum": ["long", "short", "shaved", "bun"] } },
        "beard": { "type": "number", "minimum": 0, "maximum": 1 },
        "beads": { "$ref": "#/definitions/color" },
        "feet": { "$ref": "#/definitions/color" }
      }
    },
    "tick": { "type": "array", "items": { "$ref": "#/definitions/effect" } },
    "falls": { "type": "array", "items": { "$ref": "#/definitions/fall" } },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "goal"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "goal": { "$ref": "#/definitions/goal" },
          "guard": { "$ref": "#/definitions/expr" },
          "next": { "$ref": "#/definitions/id" }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "after", "delayMin", "check", "pass", "fail"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "after": { "$ref": "#/definitions/expr" },
          "delayMin": { "type": "number", "minimum": 0 },
          "check": { "$ref": "#/definitions/expr" },
          "pass": { "type": "array", "items": { "$ref": "#/definitions/effect" } },
          "fail": { "type": "array", "items": { "$ref": "#/definitions/effect" } },
          "text": { "$ref": "#/definitions/key" }
        }
      }
    }
  }
}
