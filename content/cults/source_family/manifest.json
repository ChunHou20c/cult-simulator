{
  "schema": "1.1",
  "id": "source_family",
  "version": "2.0.0",
  "difficulty": "tutorial",
  "names": "real",
  "theme": {
    "primary": "#c8743a",
    "accent": "#f2d27a",
    "floor": "#3b2a1e"
  },
  "stats": {
    "profit": {
      "min": 0,
      "initial": 0,
      "widget": "currency",
      "label": "stat.profit"
    }
  },
  "initial": {
    "followers": 12,
    "funds": 4000,
    "loyalty": 70
  },
  "goal": {
    "progress": "min(cult.followers / 140, cult.profit / 50000)",
    "label": "goal.members_profit"
  },
  "guard": "cult.loyalty >= 60",
  "sharedActions": [],
  "actions": [
    {
      "id": "recruit",
      "slot": "recruit",
      "game": "flick",
      "skin": {
        "target": "🧑",
        "item": "🥗"
      },
      "energy": 1,
      "effects": [
        {
          "stat": "followers",
          "add": 4,
          "scale": "yield"
        },
        {
          "stat": "scrutiny",
          "add": 0.6
        },
        {
          "stat": "paranoia",
          "add": -1
        }
      ]
    },
    {
      "id": "run_restaurant",
      "slot": "work",
      "game": "timing",
      "skin": {
        "zone": "🍳"
      },
      "energy": 2,
      "cooldownSec": 60,
      "effects": [
        {
          "stat": "funds",
          "add": 300,
          "scale": "yield"
        },
        {
          "stat": "profit",
          "add": 215,
          "scale": "yield"
        },
        {
          "stat": "scrutiny",
          "add": 0.3
        }
      ]
    },
    {
      "id": "jam_session",
      "slot": "devote",
      "game": "beat",
      "skin": {
        "zone": "🥁"
      },
      "energy": 1,
      "effects": [
        {
          "stat": "loyalty",
          "add": 2.5
        },
        {
          "stat": "paranoia",
          "add": 0.5
        },
        {
          "stat": "scrutiny",
          "add": -2
        }
      ]
    }
  ],
  "tick": [
    {
      "stat": "funds",
      "add": "-cult.followers * 0.5"
    }
  ],
  "falls": [
    {
      "when": "cult.loyalty <= 0",
      "reason": "scattered",
      "text": "codex.fall.scattered",
      "historical": true
    },
    {
      "when": "cult.scrutiny >= 100",
      "reason": "raided",
      "text": "codex.fall.raided"
    }
  ],
  "animations": {
    "recruit": "talk",
    "run_restaurant": "carry",
    "jam_session": "dance"
  }
}
