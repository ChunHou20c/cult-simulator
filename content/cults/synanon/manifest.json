{
  "schema": "1.1",
  "id": "synanon",
  "version": "2.1.0",
  "difficulty": "easy",
  "names": "real",
  "theme": {
    "primary": "#2f5d50",
    "accent": "#e0b44c",
    "floor": "#1d2b27"
  },
  "stats": {
    "assets": {
      "min": 0,
      "initial": 0,
      "widget": "currency",
      "label": "stat.assets"
    }
  },
  "initial": {
    "followers": 30,
    "funds": 30000,
    "loyalty": 60
  },
  "goal": {
    "progress": "cult.assets / 30000000",
    "label": "goal.assets"
  },
  "guard": "cult.scrutiny < 70",
  "sharedActions": [],
  "actions": [
    {
      "id": "recruit",
      "slot": "recruit",
      "game": "flick",
      "skin": {
        "target": "🧍",
        "item": "📄"
      },
      "energy": 1,
      "effects": [
        {
          "stat": "followers",
          "add": 4,
          "scale": "yield"
        },
        {
          "stat": "scrutiny",
          "add": 0.6
        },
        {
          "stat": "paranoia",
          "add": -1
        }
      ]
    },
    {
      "id": "open_rehab_house",
      "slot": "work",
      "game": "timing",
      "skin": {
        "zone": "📦"
      },
      "energy": 2,
      "cooldownSec": 60,
      "effects": [
        {
          "stat": "assets",
          "add": 120000,
          "scale": "yield"
        },
        {
          "stat": "followers",
          "add": 3
        },
        {
          "stat": "scrutiny",
          "add": 1.2
        }
      ]
    },
    {
      "id": "play_the_game",
      "slot": "devote",
      "game": "beat",
      "skin": {
        "zone": "🗣️"
      },
      "energy": 1,
      "effects": [
        {
          "stat": "loyalty",
          "add": 3
        },
        {
          "stat": "paranoia",
          "add": 0.5
        },
        {
          "stat": "scrutiny",
          "add": -2
        }
      ]
    }
  ],
  "tick": [
    {
      "stat": "funds",
      "add": "cult.followers * 1.2"
    }
  ],
  "falls": [
    {
      "when": "cult.scrutiny >= 100",
      "reason": "prosecuted",
      "text": "codex.fall.prosecuted",
      "historical": true
    },
    {
      "when": "cult.paranoia >= 100",
      "reason": "violence",
      "text": "codex.fall.violence",
      "historical": true
    }
  ],
  "animations": {
    "recruit": "talk",
    "open_rehab_house": "carry",
    "play_the_game": "sit_talk"
  }
}
