{
  "schema": "1.1",
  "id": "rajneeshpuram",
  "version": "2.0.0",
  "difficulty": "medium",
  "names": "real",
  "theme": {
    "primary": "#b8325a",
    "accent": "#f0a04b",
    "floor": "#3a2430"
  },
  "stats": {
    "months": {
      "min": 0,
      "max": 60,
      "initial": 0,
      "widget": "months",
      "label": "stat.months"
    }
  },
  "initial": {
    "followers": 40,
    "funds": 60000,
    "loyalty": 65
  },
  "goal": {
    "progress": "cult.months / 60",
    "label": "goal.months"
  },
  "guard": "cult.funds > cult.followers * 20",
  "sharedActions": [],
  "actions": [
    {
      "id": "recruit",
      "slot": "recruit",
      "game": "flick",
      "skin": {
        "target": "🧑",
        "item": "🌸"
      },
      "energy": 1,
      "effects": [
        {
          "stat": "followers",
          "add": 4,
          "scale": "yield"
        },
        {
          "stat": "scrutiny",
          "add": 0.6
        },
        {
          "stat": "paranoia",
          "add": -1
        }
      ]
    },
    {
      "id": "build_on_ranch",
      "slot": "work",
      "game": "timing",
      "skin": {
        "zone": "🔨"
      },
      "energy": 2,
      "cooldownSec": 60,
      "effects": [
        {
          "stat": "funds",
          "add": 20000,
          "scale": "yield"
        },
        {
          "stat": "months",
          "add": 0.26,
          "scale": "yield"
        },
        {
          "stat": "scrutiny",
          "add": 1
        },
        {
          "stat": "paranoia",
          "add": 0.5
        }
      ]
    },
    {
      "id": "dynamic_meditation",
      "slot": "devote",
      "game": "beat",
      "skin": {
        "zone": "🧘"
      },
      "energy": 1,
      "effects": [
        {
          "stat": "loyalty",
          "add": 2.5
        },
        {
          "stat": "paranoia",
          "add": 0.5
        },
        {
          "stat": "scrutiny",
          "add": -2
        }
      ]
    }
  ],
  "tick": [
    {
      "stat": "funds",
      "add": "-cult.followers * 1"
    }
  ],
  "falls": [
    {
      "when": "cult.scrutiny >= 100",
      "reason": "federal_case",
      "text": "codex.fall.federal_case",
      "historical": true
    },
    {
      "when": "cult.paranoia >= 100",
      "reason": "the_dalles",
      "text": "codex.fall.the_dalles",
      "historical": true
    }
  ],
  "animations": {
    "recruit": "talk",
    "build_on_ranch": "fix",
    "dynamic_meditation": "dance"
  }
}
